# Playkami Verifier Environment Variables

# Monad Blockchain Configuration
# Switch between testnet/mainnet by commenting/uncommenting:
# NEXT_PUBLIC_DEFAULT_RPC_URL=https://rpc.ankr.com/monad_testnet
NEXT_PUBLIC_DEFAULT_RPC_URL=https://rpc3.monad.xyz
NEXT_PUBLIC_DROP_VENDING_MACHINE_ADDRESS=0x0000000000000000000000000000000000000000

# Block Explorer
# Testnet: https://monad-testnet.socialscan.io
# Mainnet: https://monad.socialscan.io
# NEXT_PUBLIC_EXPLORER_URL=https://monad-testnet.socialscan.io
NEXT_PUBLIC_EXPLORER_URL=https://monad.socialscan.io

# Backend API (Verifier service runs on port 8084)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8084

# Feature Flags
NEXT_PUBLIC_ENABLE_PACK_DETAILS=true

# Pack Opening Logic Cutoffs
# NEXT_PUBLIC_INCLUSIVE_LOGIC_CUTOFF: Unix timestamp before which packs use inclusive (<=) logic
# Pack 139 (1765379211) was the last pack using inclusive logic
# Cutoff: Dec 10, 2025 15:06:52 UTC
NEXT_PUBLIC_INCLUSIVE_LOGIC_CUTOFF=1765379212
